# HomeIntel configuration. Copy to .env and fill in. Never commit .env.
# Server variables are read by server/src/config/env.js and validated at startup (names only are printed on error).

# ---- Runtime --------------------------------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=5000
CLIENT_ORIGINS=http://localhost:5173 # comma-separated exact origins allowed by CORS (https required in production)
PUBLIC_APP_URL=http://localhost:5173 # public URL of the web app (used in shared-report links)
TRUST_PROXY=1                        # number of reverse-proxy hops in production (Render/Vercel: 1)
SERVE_CLIENT=0                       # 1 = this server also serves client/dist (single-origin deployment)

# ---- Database -------------------------------------------------------------------------------------------
# Use a least-privilege user with readWrite on this database only.
MONGODB_URI=mongodb://127.0.0.1:27017/homeintel

# ---- Secrets (required in production; dev generates ephemeral ones) ---------------------------------------
# JWT_ACCESS_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_SECRET_PREVIOUS=          # set to the old value while rotating; remove after 15 minutes
# MFA_ENCRYPTION_KEY: 64 hex chars (openssl rand -hex 32). Encrypts TOTP secrets at rest (AES-256-GCM).
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_PREVIOUS=         # old key while rotating (decrypt-only)

# ---- Cookies --------------------------------------------------------------------------------------------
# lax when the app and API share a site (recommended: Vercel rewrites /api to the API). 'none' requires HTTPS.
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
AUTH_RATE_LIMIT_MAX=20               # auth attempts per IP per 15 minutes

# ---- Data providers (server-side only — never prefix with VITE_) ------------------------------------------
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter   # or a self-hosted/regional Overpass instance
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org      # respect the 1 req/s usage policy
CONTACT_EMAIL=                       # sent to Nominatim per its usage policy
OPENAQ_ENDPOINT=https://api.openaq.org
OPENAQ_API_KEY=                      # https://docs.openaq.org/using-the-api/quick-start
OGD_ENDPOINT=https://api.data.gov.in
DATA_GOV_IN_API_KEY=                 # https://www.data.gov.in/ (sign in → My Account → API key)
CPCB_AQI_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69   # "Real time Air Quality Index from various locations"
CPCB_VALUE_KIND=subindex             # subindex | concentration — confirm with `npm run inspect:ogd -- <id>`
ONDEMAND_INGESTION=1                 # collect data when a signed-in user adds a locality

# ---- AI (optional — the whole product works without it) ----------------------------------------------------
AI_PROVIDER=none                     # none | anthropic | openai | gemini  (mock is test-only and refused otherwise)
AI_MODEL=                            # optional override, e.g. claude-sonnet-5-5, gpt-4o-mini or gemini-3.5-flash
AI_DAILY_LIMIT=30                    # requests per user per 24 h
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey

# ---- Webhooks ---------------------------------------------------------------------------------------------
WEBHOOK_SIGNING_SECRET=              # ≥32 chars; HMAC-SHA256 for /api/webhooks/ingestion
WEBHOOK_SIGNING_SECRET_PREVIOUS=

# ---- Logging ----------------------------------------------------------------------------------------------
LOG_LEVEL=                           # optional: fatal | error | warn | info | debug

# ---- Client (public values only — anything here is visible in the browser) --------------------------------
VITE_API_BASE_URL=/api               # keep /api with the Vite proxy or a Vercel rewrite
